          "phoneVerified": {
            "type": "boolean"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "phone",
          "status",
          "phoneVerified",
          "emailVerified",
          "createdAt"
