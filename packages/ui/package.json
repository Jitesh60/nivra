{
  "name": "@sajha/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared React components for the Sajha admin panel and website, built to DESIGN.md. Ships TypeScript source; the Next apps transpile it.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./brand/*": "./brand/*"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.81",
    "@sajha/design-tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^13.4.2",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5"
  }
}
