# Copy to .env.local: cp .env.example .env.local
# Server-side only. Where the admin app reaches the Sajha API.
SAJHA_API_URL=http://localhost:3000
# Crash reporting (optional; off when empty). Server errors and browser errors.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
