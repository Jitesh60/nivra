// Sajha database schema. Models are added phase by phase (see docs/ARCHITECTURE.md §3).
// Raw SQL (PostGIS columns, exclusion constraints) lives in the migration files.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, btree_gist, citext]
}

// ─── Phase 1a: authentication ────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

/// A person using the mobile app (borrower and/or lender).
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// E.164, e.g. +919876543210. Replaced with `deleted:<id>` when the account is deleted.
  phone           String     @unique
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  email           String?    @unique @db.Citext
  emailVerifiedAt DateTime?  @map("email_verified_at")
  name            String?
  status          UserStatus @default(ACTIVE)
  deletedAt       DateTime?  @map("deleted_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  sessions      Session[]
  otpChallenges OtpChallenge[]

  @@map("users")
}

enum AdminRole {
  SUPER_ADMIN
  OPS
  SUPPORT
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

/// Sajha staff using the admin panel. Separate from app users.
model AdminUser {
  id                 String      @id @default(uuid(7)) @db.Uuid
  email              String      @unique @db.Citext
  name               String
  passwordHash       String      @map("password_hash")
  role               AdminRole
  status             AdminStatus @default(ACTIVE)
  /// Set for invited admins and generated passwords; the admin must pick a new one.
  mustChangePassword Boolean     @default(false) @map("must_change_password")
  failedLoginCount   Int         @default(0) @map("failed_login_count")
  lockedUntil        DateTime?   @map("locked_until")
  /// AES-256-GCM encrypted base32 TOTP secret. Present (but not enabled) during setup.
  totpSecretEnc      String?     @map("totp_secret_enc")
  totpEnabledAt      DateTime?   @map("totp_enabled_at")
  /// Last accepted TOTP time step, so a code can't be replayed.
  totpLastTimeStep   Int?        @map("totp_last_time_step")
  lastLoginAt        DateTime?   @map("last_login_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  sessions      Session[]
  recoveryCodes AdminRecoveryCode[]

  @@map("admin_users")
}

/// One-time 2FA recovery codes (stored hashed).
model AdminRecoveryCode {
  id          String    @id @default(uuid(7)) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  codeHash    String    @unique @map("code_hash")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_recovery_codes")
}

enum AuthRealm {
  USER
  ADMIN
}

/// One login on one device. Access tokens carry its id (`sid`), so revoking the
/// session cuts off that device immediately. Exactly one of userId / adminUserId is set.
model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  realm        AuthRealm
  userId       String?   @map("user_id") @db.Uuid
  adminUserId  String?   @map("admin_user_id") @db.Uuid
  deviceId     String?   @map("device_id")
  deviceName   String?   @map("device_name")
  platform     String?
  ip           String?
  userAgent    String?   @map("user_agent")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUser     AdminUser?     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([adminUserId])
  @@map("sessions")
}

/// Opaque refresh tokens, rotated on every use. Presenting a token that was
/// already used means it leaked, so the whole session is revoked.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// SHA-256 of the token; the token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum OtpChannel {
  SMS
  EMAIL
}

enum OtpPurpose {
  LOGIN
  VERIFY_EMAIL
}

/// A one-time code sent by SMS or email. Only an HMAC of the code is stored.
model OtpChallenge {
  id          String     @id @default(uuid(7)) @db.Uuid
  channel     OtpChannel
  purpose     OtpPurpose
  /// Phone (E.164) or lower-cased email the code was sent to.
  target      String
  userId      String?    @map("user_id") @db.Uuid
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, purpose, createdAt])
  @@map("otp_challenges")
}

enum ActorType {
  ADMIN
  USER
  SYSTEM
}

/// Append-only record of security-relevant actions (admin actions, logins, deletions).
model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  /// Dotted action name, e.g. admin.login, admin.admins.create, user.account.delete
  action     String
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([actorType, actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
