// Sajha database schema. Models are added phase by phase (see docs/ARCHITECTURE.md §3).
// Raw SQL (PostGIS columns, exclusion constraints) lives in the migration files.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, btree_gist, citext]
}

// ─── Phase 1a: authentication ────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

/// A person using the mobile app (borrower and/or lender).
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// E.164, e.g. +919876543210. Replaced with `deleted:<id>` when the account is deleted.
  phone           String     @unique
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  email           String?    @unique @db.Citext
  emailVerifiedAt DateTime?  @map("email_verified_at")
  name            String?
  status          UserStatus @default(ACTIVE)
  deletedAt       DateTime?  @map("deleted_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  sessions      Session[]
  otpChallenges OtpChallenge[]
  profile       Profile?
  documents     UserDocument[]
  listings      Listing[]
  favorites     Favorite[]

  borrowerConversations Conversation[]    @relation("ConversationBorrower")
  lenderConversations   Conversation[]    @relation("ConversationLender")
  messages              Message[]
  offers                Offer[]
  blocksMade            UserBlock[]       @relation("BlockBlocker")
  blocksReceived        UserBlock[]       @relation("BlockBlocked")
  reports               Report[]
  deviceTokens          DeviceToken[]
  borrowerBookings      Booking[]         @relation("BookingBorrower")
  lenderBookings        Booking[]         @relation("BookingLender")
  notifications         Notification[]
  notificationPrefs     NotificationPreferences?
  payoutAccount         PayoutAccount?
  transfers             Transfer[]
  conditionReports      ConditionReport[]
  disputesOpened        Dispute[]
  reviewsWritten        Review[]          @relation("ReviewAuthor")
  reviewsReceived       Review[]          @relation("ReviewSubject")

  @@map("users")
}

enum AdminRole {
  SUPER_ADMIN
  OPS
  SUPPORT
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

/// Sajha staff using the admin panel. Separate from app users.
model AdminUser {
  id                 String      @id @default(uuid(7)) @db.Uuid
  email              String      @unique @db.Citext
  name               String
  passwordHash       String      @map("password_hash")
  role               AdminRole
  status             AdminStatus @default(ACTIVE)
  /// Set for invited admins and generated passwords; the admin must pick a new one.
  mustChangePassword Boolean     @default(false) @map("must_change_password")
  failedLoginCount   Int         @default(0) @map("failed_login_count")
  lockedUntil        DateTime?   @map("locked_until")
  /// AES-256-GCM encrypted base32 TOTP secret. Present (but not enabled) during setup.
  totpSecretEnc      String?     @map("totp_secret_enc")
  totpEnabledAt      DateTime?   @map("totp_enabled_at")
  /// Last accepted TOTP time step, so a code can't be replayed.
  totpLastTimeStep   Int?        @map("totp_last_time_step")
  lastLoginAt        DateTime?   @map("last_login_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  sessions          Session[]
  recoveryCodes     AdminRecoveryCode[]
  reviewedDocuments UserDocument[]
  reviewedListings  Listing[]
  resolvedReports   Report[]
  resolvedDisputes  Dispute[]

  @@map("admin_users")
}

/// One-time 2FA recovery codes (stored hashed).
model AdminRecoveryCode {
  id          String    @id @default(uuid(7)) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  codeHash    String    @unique @map("code_hash")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_recovery_codes")
}

enum AuthRealm {
  USER
  ADMIN
}

/// One login on one device. Access tokens carry its id (`sid`), so revoking the
/// session cuts off that device immediately. Exactly one of userId / adminUserId is set.
model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  realm        AuthRealm
  userId       String?   @map("user_id") @db.Uuid
  adminUserId  String?   @map("admin_user_id") @db.Uuid
  deviceId     String?   @map("device_id")
  deviceName   String?   @map("device_name")
  platform     String?
  ip           String?
  userAgent    String?   @map("user_agent")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUser     AdminUser?     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]

  @@index([userId])
  @@index([adminUserId])
  @@map("sessions")
}

/// Opaque refresh tokens, rotated on every use. Presenting a token that was
/// already used means it leaked, so the whole session is revoked.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// SHA-256 of the token; the token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum OtpChannel {
  SMS
  EMAIL
}

enum OtpPurpose {
  LOGIN
  VERIFY_EMAIL
}

/// A one-time code sent by SMS or email. Only an HMAC of the code is stored.
model OtpChallenge {
  id          String     @id @default(uuid(7)) @db.Uuid
  channel     OtpChannel
  purpose     OtpPurpose
  /// Phone (E.164) or lower-cased email the code was sent to.
  target      String
  userId      String?    @map("user_id") @db.Uuid
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, purpose, createdAt])
  @@map("otp_challenges")
}

enum ActorType {
  ADMIN
  USER
  SYSTEM
}

/// Append-only record of security-relevant actions (admin actions, logins, deletions).
model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  /// Dotted action name, e.g. admin.login, admin.admins.create, user.account.delete
  action     String
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([actorType, actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─── Phase 1d: marketing waitlist ────────────────────────────────────────────

enum WaitlistRole {
  BORROWER
  LENDER
  BOTH
}

/// People who asked to hear when Sajha launches (marketing website).
model WaitlistEntry {
  id        String        @id @default(uuid(7)) @db.Uuid
  email     String        @unique @db.Citext
  city      String?
  role      WaitlistRole?
  /// utm_source or referrer, for launch attribution.
  source    String?
  ip        String?
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("waitlist_entries")
}

// ─── Phase 2: profiles & verification ────────────────────────────────────────

/// Public-facing profile details. Created on first update; `name` stays on User.
model Profile {
  userId      String   @id @map("user_id") @db.Uuid
  city        String?
  bio         String?
  /// Object key of the processed 512×512 WebP avatar in the public bucket.
  avatarKey   String?  @map("avatar_key")
  /// Published reviews of this person (Phase 8), kept in sync when one is published.
  ratingAvg   Float?   @map("rating_avg")
  ratingCount Int      @default(0) @map("rating_count")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

enum DocumentType {
  AADHAAR_MASKED
  PAN
  DRIVING_LICENCE
  PASSPORT
  VOTER_ID
  COLLEGE_ID
  EMPLOYEE_ID
  ADDRESS_PROOF
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// An identity document in the user's private vault. Files live in the private
/// bucket (re-encoded, EXIF stripped); only short-lived signed URLs are handed out.
/// One live (PENDING/APPROVED, not deleted) document per type: partial unique
/// index in the migration.
model UserDocument {
  id              String         @id @default(uuid(7)) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  type            DocumentType
  /// Required for OTHER, e.g. "Gym membership card".
  label           String?
  frontKey        String         @map("front_key")
  backKey         String?        @map("back_key")
  status          DocumentStatus @default(PENDING)
  rejectionReason String?        @map("rejection_reason")
  reviewedById    String?        @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?      @map("reviewed_at")
  expiresOn       DateTime?      @map("expires_on") @db.Date
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy AdminUser?             @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  shares     BookingDocumentShare[]

  @@index([userId])
  @@index([status, createdAt])
  @@map("user_documents")
}

// ─── Phase 3: listings & categories ──────────────────────────────────────────

/// Admin-managed item categories (flat for the MVP). Launch set seeded by the migration.
model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  /// Material Symbols icon name shown in the apps, e.g. "hiking".
  icon      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listings Listing[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ListingStatus {
  /// Being written by the lender; never public.
  DRAFT
  /// Waiting for admin review (a lender's first listing).
  PENDING
  LIVE
  /// Hidden by the lender; can be unpaused.
  PAUSED
  /// Admin sent it back with a reason; editing returns it to DRAFT.
  REJECTED
  /// Unpublished by an admin.
  REMOVED
  /// Deleted by the lender (soft delete; photos removed from storage).
  DELETED
}

/// An item a lender offers for rent. Money is in paise. The exact pickup point
/// (lat/lng) and address are private; the public API shows an approximate
/// location and `areaLabel`. `location` (geography) is kept in sync with lat/lng
/// by a trigger (see the migration) and used for radius search in Phase 4.
model Listing {
  id                String                    @id @default(uuid(7)) @db.Uuid
  lenderId          String                    @map("lender_id") @db.Uuid
  categoryId        String                    @map("category_id") @db.Uuid
  title             String
  description       String
  condition         ItemCondition
  brand             String?
  size              String?
  pricePerDayPaise  Int                       @map("price_per_day_paise")
  /// Discount for rentals of 7+ days, 0–50.
  weeklyDiscountPct Int                       @default(0) @map("weekly_discount_pct")
  depositPaise      Int                       @map("deposit_paise")
  minDays           Int                       @default(1) @map("min_days")
  maxDays           Int                       @default(30) @map("max_days")
  advanceNoticeDays Int                       @default(1) @map("advance_notice_days")
  lat               Float?
  lng               Float?
  location          Unsupported("geography")?
  /// Full-text search: title (A), brand and category (B), description (C).
  /// Kept in sync by a trigger (see the migrations).
  searchVector      Unsupported("tsvector")?  @map("search_vector")
  /// Public, e.g. "Kothrud, Pune".
  areaLabel         String?                   @map("area_label")
  /// AES-256-GCM (ADDRESS_ENC_KEY); shared with a borrower only after a confirmed booking.
  exactAddressEnc   String?                   @map("exact_address_enc")
  status            ListingStatus             @default(DRAFT)
  rejectionReason   String?                   @map("rejection_reason")
  reviewedById      String?                   @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?                 @map("reviewed_at")
  /// Set when an admin approves it. A lender with any approved listing publishes straight to LIVE.
  approvedAt        DateTime?                 @map("approved_at")
  publishedAt       DateTime?                 @map("published_at")
  /// Borrowers' published reviews of rentals of this item (Phase 8).
  ratingAvg         Float?                    @map("rating_avg")
  ratingCount       Int                       @default(0) @map("rating_count")
  deletedAt         DateTime?                 @map("deleted_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  lender        User                 @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  category      Category             @relation(fields: [categoryId], references: [id])
  reviewedBy    AdminUser?           @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  photos        ListingPhoto[]
  requiredDocs  ListingRequiredDoc[]
  blocks        AvailabilityBlock[]
  favorites     Favorite[]
  views         ListingView[]
  conversations Conversation[]
  bookings      Booking[]

  @@index([lenderId])
  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([location], map: "listings_location_gist", type: Gist)
  @@index([searchVector], map: "listings_search_vector_gin", type: Gin)
  @@map("listings")
}

/// Processed photo in the public bucket: `key` (≤1600px WebP) and `thumbKey` (≤480px WebP).
model ListingPhoto {
  id        String   @id @default(uuid(7)) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  key       String
  thumbKey  String   @map("thumb_key")
  width     Int
  height    Int
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("listing_photos")
}

/// What a borrower must share before a booking (Phase 6 does the sharing).
enum RequiredDocType {
  /// Any of Aadhaar (masked), PAN, driving licence, passport or voter ID.
  GOVERNMENT_ID
  COLLEGE_OR_EMPLOYEE_ID
  ADDRESS_PROOF
  OTHER
}

model ListingRequiredDoc {
  id        String          @id @default(uuid(7)) @db.Uuid
  listingId String          @map("listing_id") @db.Uuid
  docType   RequiredDocType @map("doc_type")
  /// Required for OTHER (CHECK in the migration), e.g. "Trek permit".
  note      String?

  listing Listing                @relation(fields: [listingId], references: [id], onDelete: Cascade)
  shares  BookingDocumentShare[]

  @@unique([listingId, docType])
  @@map("listing_required_docs")
}

enum BlockReason {
  OWNER_BLOCK
}

/// Dates the lender blocked (inclusive). Held bookings are checked separately (see bookings/availability.ts).
model AvailabilityBlock {
  id        String      @id @default(uuid(7)) @db.Uuid
  listingId String      @map("listing_id") @db.Uuid
  startsOn  DateTime    @map("starts_on") @db.Date
  endsOn    DateTime    @map("ends_on") @db.Date
  reason    BlockReason @default(OWNER_BLOCK)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, startsOn])
  @@map("availability_blocks")
}

// ─── Phase 4: discovery ──────────────────────────────────────────────────────

/// A listing a user saved to their wishlist.
model Favorite {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId, createdAt])
  @@map("favorites")
}

/// One row per viewer per listing per day ("Popular this week"). `viewerKey`
/// is the user id, or for guests a salted hash of IP + user agent + day, so no
/// raw IP is stored.
model ListingView {
  listingId String   @map("listing_id") @db.Uuid
  viewerKey String   @map("viewer_key")
  day       DateTime @db.Date

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([listingId, viewerKey, day])
  @@index([day, listingId])
  @@map("listing_views")
}

// ─── Phase 5: chat, offers, safety, push ─────────────────────────────────────

/// One thread per borrower and listing. Only the borrower starts it.
model Conversation {
  id                 String   @id @default(uuid(7)) @db.Uuid
  listingId          String   @map("listing_id") @db.Uuid
  borrowerId         String   @map("borrower_id") @db.Uuid
  lenderId           String   @map("lender_id") @db.Uuid
  lastMessageAt      DateTime @default(now()) @map("last_message_at")
  /// Masked, so it's safe to show either participant.
  lastMessagePreview String?  @map("last_message_preview")
  createdAt          DateTime @default(now()) @map("created_at")

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  borrower User      @relation("ConversationBorrower", fields: [borrowerId], references: [id], onDelete: Cascade)
  lender   User      @relation("ConversationLender", fields: [lenderId], references: [id], onDelete: Cascade)
  messages Message[]
  offers   Offer[]
  bookings Booking[]

  @@unique([listingId, borrowerId])
  @@index([borrowerId, lastMessageAt])
  @@index([lenderId, lastMessageAt])
  @@map("conversations")
}

enum MessageType {
  TEXT
  IMAGE
  OFFER
  SYSTEM
}

/// `body` is what the sender typed (shown to them and to admins); the other
/// participant only ever gets `maskedBody` (contact details replaced with •••).
model Message {
  id             String      @id @default(uuid(7)) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  type           MessageType
  body           String?
  maskedBody     String?     @map("masked_body")
  masked         Boolean     @default(false)
  /// Private bucket: `imageKey` (≤1600px WebP) and `thumbKey` (≤480px WebP).
  imageKey       String?     @map("image_key")
  thumbKey       String?     @map("thumb_key")
  offerId        String?     @unique @map("offer_id") @db.Uuid
  /// The sender's id for this message, so a retried send isn't stored twice.
  clientId       String?     @map("client_id")
  readAt         DateTime?   @map("read_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  offer        Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@unique([conversationId, senderId, clientId])
  @@index([conversationId, id])
  @@map("messages")
}

enum OfferStatus {
  PENDING
  ACCEPTED
  COUNTERED
  DECLINED
  EXPIRED
  /// An accepted deal replaced by a later one in the same conversation.
  SUPERSEDED
}

/// Dates and a price per day proposed in chat. At most one PENDING and one
/// ACCEPTED offer per conversation (partial unique indexes in the migration).
/// Expiry is applied lazily: a PENDING offer past `expiresAt` counts as EXPIRED.
model Offer {
  id               String      @id @default(uuid(7)) @db.Uuid
  conversationId   String      @map("conversation_id") @db.Uuid
  proposedById     String      @map("proposed_by_id") @db.Uuid
  startsOn         DateTime    @map("starts_on") @db.Date
  endsOn           DateTime    @map("ends_on") @db.Date
  days             Int
  pricePerDayPaise Int         @map("price_per_day_paise")
  rentPaise        Int         @map("rent_paise")
  depositPaise     Int         @map("deposit_paise")
  status           OfferStatus @default(PENDING)
  parentOfferId    String?     @map("parent_offer_id") @db.Uuid
  expiresAt        DateTime    @map("expires_at")
  respondedAt      DateTime?   @map("responded_at")
  createdAt        DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  proposedBy   User         @relation(fields: [proposedById], references: [id], onDelete: Cascade)
  parent       Offer?       @relation("OfferCounter", fields: [parentOfferId], references: [id], onDelete: SetNull)
  counters     Offer[]      @relation("OfferCounter")
  message      Message?
  booking      Booking?

  @@index([conversationId, createdAt])
  @@map("offers")
}

/// Either side of a block stops messages and offers both ways.
model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

enum ReportTarget {
  USER
  LISTING
  MESSAGE
}

enum ReportReason {
  SPAM
  SCAM
  OFF_PLATFORM_PAYMENT
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model Report {
  id             String       @id @default(uuid(7)) @db.Uuid
  reporterId     String       @map("reporter_id") @db.Uuid
  targetType     ReportTarget @map("target_type")
  targetId       String       @map("target_id") @db.Uuid
  /// The chat it came from, for context in the admin panel.
  conversationId String?      @map("conversation_id") @db.Uuid
  reason         ReportReason
  note           String?
  status         ReportStatus @default(OPEN)
  resolvedById   String?      @map("resolved_by_id") @db.Uuid
  resolutionNote String?      @map("resolution_note")
  resolvedAt     DateTime?    @map("resolved_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  reporter   User       @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy AdminUser? @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

/// An FCM registration token for one signed-in device (session).
model DeviceToken {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  token      String   @unique
  platform   String
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("device_tokens")
}

// ─── Phase 6: bookings, document sharing, notifications ──────────────────────

/// See docs/ARCHITECTURE.md §5. Phase 6 reaches REQUESTED → AWAITING_DOCS →
/// AWAITING_PAYMENT and the closed states; payment (Phase 7) and handover
/// (Phase 8) add the rest. "Accepted" is an event, not a resting status.
enum BookingStatus {
  REQUESTED
  AWAITING_DOCS
  AWAITING_PAYMENT
  CONFIRMED
  ACTIVE
  RETURNED
  COMPLETED
  DISPUTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum BookingSource {
  /// "Request to book" from the item page, at the listed price.
  REQUEST
  /// An offer accepted in chat, at the agreed price (already accepted by both).
  OFFER
}

enum BookingParty {
  BORROWER
  LENDER
  ADMIN
}

/// A rental of one listing for inclusive dates. Money is in paise. The dates are
/// held (no overlap, exclusion constraint in the migration) from AWAITING_PAYMENT on.
model Booking {
  id               String        @id @default(uuid(7)) @db.Uuid
  listingId        String        @map("listing_id") @db.Uuid
  borrowerId       String        @map("borrower_id") @db.Uuid
  lenderId         String        @map("lender_id") @db.Uuid
  conversationId   String        @map("conversation_id") @db.Uuid
  offerId          String?       @unique @map("offer_id") @db.Uuid
  source           BookingSource
  startsOn         DateTime      @map("starts_on") @db.Date
  endsOn           DateTime      @map("ends_on") @db.Date
  days             Int
  pricePerDayPaise Int           @map("price_per_day_paise")
  rentPaise        Int           @map("rent_paise")
  feePaise         Int           @map("fee_paise")
  depositPaise     Int           @map("deposit_paise")
  totalPaise       Int           @map("total_paise")
  status           BookingStatus
  /// Deadline of the current step; the booking expires after it.
  expiresAt        DateTime?     @map("expires_at")
  declineReason    String?       @map("decline_reason")
  cancelledById    String?       @map("cancelled_by_id") @db.Uuid
  cancelledBy      BookingParty? @map("cancelled_by")
  cancelReason     String?       @map("cancel_reason")
  /// When it reached a closed state; document access ends then.
  closedAt         DateTime?     @map("closed_at")
  /// Rental (Phase 8): when the item changed hands, came back and the booking completed.
  handedOverAt     DateTime?     @map("handed_over_at")
  returnedAt       DateTime?     @map("returned_at")
  completedAt      DateTime?     @map("completed_at")
  /// The lender marked the borrower as a no-show (cancelled as a late borrower cancellation).
  noShowAt         DateTime?     @map("no_show_at")
  /// Started days late at return, and the fee (1× daily rate each, capped at the deposit).
  lateDays         Int           @default(0) @map("late_days")
  lateFeePaise     Int           @default(0) @map("late_fee_paise")
  /// Deposit the lender keeps: the late fee plus what an admin awarded in a dispute.
  keptPaise        Int           @default(0) @map("kept_paise")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  listing          Listing                @relation(fields: [listingId], references: [id], onDelete: Cascade)
  borrower         User                   @relation("BookingBorrower", fields: [borrowerId], references: [id], onDelete: Cascade)
  lender           User                   @relation("BookingLender", fields: [lenderId], references: [id], onDelete: Cascade)
  conversation     Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  offer            Offer?                 @relation(fields: [offerId], references: [id], onDelete: SetNull)
  events           BookingEvent[]
  shares           BookingDocumentShare[]
  payments         Payment[]
  refunds          Refund[]
  transfers        Transfer[]
  conditionReports ConditionReport[]
  dispute          Dispute?
  reviews          Review[]

  @@index([borrowerId, createdAt])
  @@index([lenderId, createdAt])
  @@index([listingId, status])
  @@index([status, expiresAt])
  @@map("bookings")
}

enum BookingEventType {
  REQUESTED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
  DOCS_SUBMITTED
  DOCS_APPROVED
  DOCS_REJECTED
  /// Payment captured: the booking is confirmed (Phase 7).
  PAID
  /// Phase 8: the rental.
  HANDED_OVER
  RETURNED
  NO_SHOW
  DISPUTED
  COMPLETED
  DISPUTE_RESOLVED
}

enum RentalStage {
  HANDOVER
  RETURN
}

/// Condition photos one person took at handover or return (evidence for disputes).
model ConditionReport {
  id        String      @id @default(uuid(7)) @db.Uuid
  bookingId String      @map("booking_id") @db.Uuid
  stage     RentalStage
  byUserId  String      @map("by_user_id") @db.Uuid
  /// Private-bucket keys of processed WebP photos.
  photoKeys String[]    @map("photo_keys")
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  byUser  User    @relation(fields: [byUserId], references: [id], onDelete: Cascade)

  @@unique([bookingId, stage, byUserId])
  @@map("condition_reports")
}

enum DisputeReason {
  DAMAGE
  MISSING_PARTS
  NOT_RETURNED
  OTHER
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

/// A lender's claim on the deposit, settled by an admin.
model Dispute {
  id             String        @id @default(uuid(7)) @db.Uuid
  bookingId      String        @unique @map("booking_id") @db.Uuid
  openedById     String        @map("opened_by_id") @db.Uuid
  reason         DisputeReason
  description    String
  /// What the lender asks to keep (at most the deposit less any late fee).
  claimPaise     Int           @map("claim_paise")
  evidenceKeys   String[]      @map("evidence_keys")
  /// The borrower's side, once.
  responseNote   String?       @map("response_note")
  responseKeys   String[]      @default([]) @map("response_keys")
  respondedAt    DateTime?     @map("responded_at")
  status         DisputeStatus @default(OPEN)
  /// What the admin let the lender keep.
  keptPaise      Int?          @map("kept_paise")
  resolutionNote String?       @map("resolution_note")
  resolvedById   String?       @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?     @map("resolved_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  openedBy   User       @relation(fields: [openedById], references: [id], onDelete: Cascade)
  resolvedBy AdminUser? @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("disputes")
}

/// A rating after a completed rental. Double-blind: hidden until both have
/// written one, or 7 days after completion.
model Review {
  id          String       @id @default(uuid(7)) @db.Uuid
  bookingId   String       @map("booking_id") @db.Uuid
  authorId    String       @map("author_id") @db.Uuid
  subjectId   String       @map("subject_id") @db.Uuid
  /// The author's side of the booking.
  authorRole  BookingParty @map("author_role")
  rating      Int
  comment     String?
  publishedAt DateTime?    @map("published_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author  User    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject User    @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([bookingId, authorId])
  @@index([subjectId, publishedAt])
  @@map("reviews")
}

/// Append-only timeline of a booking.
model BookingEvent {
  id         String           @id @default(uuid(7)) @db.Uuid
  bookingId  String           @map("booking_id") @db.Uuid
  type       BookingEventType
  fromStatus BookingStatus?   @map("from_status")
  toStatus   BookingStatus    @map("to_status")
  actorType  ActorType        @map("actor_type")
  actorId    String?          @map("actor_id") @db.Uuid
  note       String?
  createdAt  DateTime         @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

enum ShareStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

/// A copy of a vault document shared with one lender for one booking. The files
/// are copied to `bookings/{bookingId}/…` in the private bucket and deleted
/// `SHARE_RETENTION_DAYS` after the booking closes.
model BookingDocumentShare {
  id              String       @id @default(uuid(7)) @db.Uuid
  bookingId       String       @map("booking_id") @db.Uuid
  requiredDocId   String?      @map("required_doc_id") @db.Uuid
  userDocumentId  String?      @map("user_document_id") @db.Uuid
  docType         DocumentType @map("doc_type")
  label           String?
  /// Whether Sajha had verified the vault document when it was shared.
  verified        Boolean      @default(false)
  frontKey        String?      @map("front_key")
  backKey         String?      @map("back_key")
  status          ShareStatus  @default(SUBMITTED)
  accessExpiresAt DateTime?    @map("access_expires_at")
  purgedAt        DateTime?    @map("purged_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  booking      Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requiredDoc  ListingRequiredDoc? @relation(fields: [requiredDocId], references: [id], onDelete: SetNull)
  userDocument UserDocument?       @relation(fields: [userDocumentId], references: [id], onDelete: SetNull)
  accessLogs   DocumentAccessLog[]

  @@index([bookingId])
  @@index([accessExpiresAt, purgedAt])
  @@map("booking_document_shares")
}

/// Every time a shared document is opened. The borrower sees these.
model DocumentAccessLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  shareId    String    @map("share_id") @db.Uuid
  viewerId   String    @map("viewer_id") @db.Uuid
  viewerType ActorType @map("viewer_type")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")

  share BookingDocumentShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId, createdAt])
  @@map("document_access_logs")
}

/// In-app notification (the bell). Push, when sent, carries the same text.
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// e.g. booking.requested, booking.docs_approved
  type      String
  title     String
  body      String
  /// e.g. {"bookingId": "…"}
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  /// Plus a partial index on (user_id) WHERE read_at IS NULL for unread counts (migration SQL).
  @@map("notifications")
}

// ─── Phase 9: launch ─────────────────────────────────────────────────────────

/// What a user wants to hear about, per channel. No row = the defaults.
/// In-app notifications, codes and security or legal messages always go out.
model NotificationPreferences {
  userId        String   @id @map("user_id") @db.Uuid
  /// Push: requests, acceptances, payments, handover and return, disputes, refunds.
  pushBookings  Boolean  @default(true) @map("push_bookings")
  /// Push: new chat messages.
  pushChat      Boolean  @default(true) @map("push_chat")
  /// Push: pickup and return reminders.
  pushReminders Boolean  @default(true) @map("push_reminders")
  /// Email: receipts, refunds and dispute outcomes (to a verified email).
  emailBookings Boolean  @default(true) @map("email_bookings")
  /// SMS: overdue return reminders.
  smsReminders  Boolean  @default(true) @map("sms_reminders")
  /// News and offers from Sajha (off until the user opts in).
  marketing     Boolean  @default(false)
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ─── Phase 7: payments, refunds, payouts, ledger ─────────────────────────────

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

/**
 * One checkout attempt: a Razorpay order, and the payment made against it.
 */
model Payment {
  id            String        @id @default(uuid(7)) @db.Uuid
  bookingId     String        @map("booking_id") @db.Uuid
  /// razorpay | fake
  provider      String
  orderId       String        @unique @map("order_id")
  paymentId     String?       @unique @map("payment_id")
  amountPaise   Int           @map("amount_paise")
  currency      String        @default("INR")
  method        String?
  status        PaymentStatus @default(CREATED)
  failureReason String?       @map("failure_reason")
  capturedAt    DateTime?     @map("captured_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  booking   Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds   Refund[]
  transfers Transfer[]

  @@index([bookingId])
  @@index([status, createdAt])
  @@map("payments")
}

enum RefundKind {
  /// A cancellation, by the cancellation policy.
  CANCELLATION
  /// Paid after the booking stopped waiting for payment: everything back.
  LATE_PAYMENT
  /// An admin's goodwill refund.
  MANUAL
  /// After the rental: the deposit, less anything the lender keeps.
  DEPOSIT_RETURN
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  bookingId        String       @map("booking_id") @db.Uuid
  providerRefundId String?      @unique @map("provider_refund_id")
  amountPaise      Int          @map("amount_paise")
  /// {rentPaise, feePaise, depositPaise} for cancellations.
  breakdown        Json?
  kind             RefundKind
  reason           String?
  status           RefundStatus @default(PENDING)
  failureReason    String?      @map("failure_reason")
  /// Provider calls tried so far (failed ones are retried a few times).
  attempts         Int          @default(0)
  adminId          String?      @map("admin_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status, createdAt])
  @@map("refunds")
}

enum PayoutAccountStatus {
  PENDING
  NEEDS_CLARIFICATION
  ACTIVATED
  REJECTED
}

/**
 * A lender's Razorpay Route linked account. Full bank and PAN numbers go to Razorpay only.
 */
model PayoutAccount {
  id                String              @id @default(uuid(7)) @db.Uuid
  userId            String              @unique @map("user_id") @db.Uuid
  providerAccountId String?             @unique @map("provider_account_id")
  status            PayoutAccountStatus @default(PENDING)
  statusReason      String?             @map("status_reason")
  beneficiaryName   String              @map("beneficiary_name")
  bankLast4         String              @map("bank_last4")
  ifsc              String
  panLast4          String              @map("pan_last4")
  email             String
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payout_accounts")
}

enum TransferStatus {
  /// The lender has no active payout account yet; created once they do.
  AWAITING_ACCOUNT
  /// At Razorpay, held until the item is returned (released in Phase 8).
  ON_HOLD
  RELEASED
  REVERSED
  FAILED
}

/**
 * The lender's share of a booking's rent, sent through Route.
 */
model Transfer {
  id                 String         @id @default(uuid(7)) @db.Uuid
  bookingId          String         @map("booking_id") @db.Uuid
  lenderId           String         @map("lender_id") @db.Uuid
  paymentId          String         @map("payment_id") @db.Uuid
  providerTransferId String?        @unique @map("provider_transfer_id")
  amountPaise        Int            @map("amount_paise")
  /// Held until the return (booking rent), or paid straight away (a cancellation's kept share).
  onHold             Boolean        @default(true) @map("on_hold")
  /// Deposit the lender keeps after the rental (late fee, dispute award), not rent.
  fromDeposit        Boolean        @default(false) @map("from_deposit")
  status             TransferStatus
  failureReason      String?        @map("failure_reason")
  /// Provider calls tried so far (failed ones are retried a few times).
  attempts           Int            @default(0)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lender  User    @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([lenderId, status])
  @@index([status, createdAt])
  @@map("transfers")
}

enum LedgerAccount {
  /// Money at Razorpay (collected, not yet refunded or transferred).
  GATEWAY
  DEPOSIT_HELD
  LENDER_PAYABLE
  PLATFORM_REVENUE
  /// Sajha's own money given back (manual refunds).
  GOODWILL
}

/**
 * Double-entry ledger: every money movement is a transaction (`txnId`) whose
 * debits equal its credits (a deferred trigger checks it at commit).
 */
model LedgerEntry {
  id          String        @id @default(uuid(7)) @db.Uuid
  txnId       String        @map("txn_id") @db.Uuid
  bookingId   String?       @map("booking_id") @db.Uuid
  /// e.g. PAYMENT_CAPTURED, REFUND, TRANSFER, TRANSFER_REVERSAL
  type        String
  account     LedgerAccount
  debitPaise  Int           @default(0) @map("debit_paise")
  creditPaise Int           @default(0) @map("credit_paise")
  externalRef String?       @map("external_ref")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([txnId])
  @@index([bookingId])
  @@index([account])
  @@map("ledger_entries")
}

/**
 * Webhooks already handled (Razorpay retries; each event is applied once).
 */
model WebhookEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  type        String
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@unique([provider, eventId])
  @@map("webhook_events")
}
