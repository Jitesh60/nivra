// Sajha database schema. Models are added phase by phase (see docs/ARCHITECTURE.md §3).
// Raw SQL (PostGIS columns, exclusion constraints) lives in the migration files.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, btree_gist, citext]
}

// ─── Phase 1a: authentication ────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

/// A person using the mobile app (borrower and/or lender).
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// E.164, e.g. +919876543210. Replaced with `deleted:<id>` when the account is deleted.
  phone           String     @unique
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  email           String?    @unique @db.Citext
  emailVerifiedAt DateTime?  @map("email_verified_at")
  name            String?
  status          UserStatus @default(ACTIVE)
  deletedAt       DateTime?  @map("deleted_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  sessions      Session[]
  otpChallenges OtpChallenge[]
  profile       Profile?
  documents     UserDocument[]
  listings      Listing[]
  favorites     Favorite[]

  borrowerConversations Conversation[] @relation("ConversationBorrower")
  lenderConversations   Conversation[] @relation("ConversationLender")
  messages              Message[]
  offers                Offer[]
  blocksMade            UserBlock[]    @relation("BlockBlocker")
  blocksReceived        UserBlock[]    @relation("BlockBlocked")
  reports               Report[]
  deviceTokens          DeviceToken[]

  @@map("users")
}

enum AdminRole {
  SUPER_ADMIN
  OPS
  SUPPORT
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

/// Sajha staff using the admin panel. Separate from app users.
model AdminUser {
  id                 String      @id @default(uuid(7)) @db.Uuid
  email              String      @unique @db.Citext
  name               String
  passwordHash       String      @map("password_hash")
  role               AdminRole
  status             AdminStatus @default(ACTIVE)
  /// Set for invited admins and generated passwords; the admin must pick a new one.
  mustChangePassword Boolean     @default(false) @map("must_change_password")
  failedLoginCount   Int         @default(0) @map("failed_login_count")
  lockedUntil        DateTime?   @map("locked_until")
  /// AES-256-GCM encrypted base32 TOTP secret. Present (but not enabled) during setup.
  totpSecretEnc      String?     @map("totp_secret_enc")
  totpEnabledAt      DateTime?   @map("totp_enabled_at")
  /// Last accepted TOTP time step, so a code can't be replayed.
  totpLastTimeStep   Int?        @map("totp_last_time_step")
  lastLoginAt        DateTime?   @map("last_login_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  sessions          Session[]
  recoveryCodes     AdminRecoveryCode[]
  reviewedDocuments UserDocument[]
  reviewedListings  Listing[]
  resolvedReports   Report[]

  @@map("admin_users")
}

/// One-time 2FA recovery codes (stored hashed).
model AdminRecoveryCode {
  id          String    @id @default(uuid(7)) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  codeHash    String    @unique @map("code_hash")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_recovery_codes")
}

enum AuthRealm {
  USER
  ADMIN
}

/// One login on one device. Access tokens carry its id (`sid`), so revoking the
/// session cuts off that device immediately. Exactly one of userId / adminUserId is set.
model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  realm        AuthRealm
  userId       String?   @map("user_id") @db.Uuid
  adminUserId  String?   @map("admin_user_id") @db.Uuid
  deviceId     String?   @map("device_id")
  deviceName   String?   @map("device_name")
  platform     String?
  ip           String?
  userAgent    String?   @map("user_agent")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUser     AdminUser?     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]

  @@index([userId])
  @@index([adminUserId])
  @@map("sessions")
}

/// Opaque refresh tokens, rotated on every use. Presenting a token that was
/// already used means it leaked, so the whole session is revoked.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// SHA-256 of the token; the token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum OtpChannel {
  SMS
  EMAIL
}

enum OtpPurpose {
  LOGIN
  VERIFY_EMAIL
}

/// A one-time code sent by SMS or email. Only an HMAC of the code is stored.
model OtpChallenge {
  id          String     @id @default(uuid(7)) @db.Uuid
  channel     OtpChannel
  purpose     OtpPurpose
  /// Phone (E.164) or lower-cased email the code was sent to.
  target      String
  userId      String?    @map("user_id") @db.Uuid
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, purpose, createdAt])
  @@map("otp_challenges")
}

enum ActorType {
  ADMIN
  USER
  SYSTEM
}

/// Append-only record of security-relevant actions (admin actions, logins, deletions).
model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  /// Dotted action name, e.g. admin.login, admin.admins.create, user.account.delete
  action     String
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([actorType, actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─── Phase 1d: marketing waitlist ────────────────────────────────────────────

enum WaitlistRole {
  BORROWER
  LENDER
  BOTH
}

/// People who asked to hear when Sajha launches (marketing website).
model WaitlistEntry {
  id        String        @id @default(uuid(7)) @db.Uuid
  email     String        @unique @db.Citext
  city      String?
  role      WaitlistRole?
  /// utm_source or referrer, for launch attribution.
  source    String?
  ip        String?
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("waitlist_entries")
}

// ─── Phase 2: profiles & verification ────────────────────────────────────────

/// Public-facing profile details. Created on first update; `name` stays on User.
model Profile {
  userId    String   @id @map("user_id") @db.Uuid
  city      String?
  bio       String?
  /// Object key of the processed 512×512 WebP avatar in the public bucket.
  avatarKey String?  @map("avatar_key")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

enum DocumentType {
  AADHAAR_MASKED
  PAN
  DRIVING_LICENCE
  PASSPORT
  VOTER_ID
  COLLEGE_ID
  EMPLOYEE_ID
  ADDRESS_PROOF
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// An identity document in the user's private vault. Files live in the private
/// bucket (re-encoded, EXIF stripped); only short-lived signed URLs are handed out.
/// One live (PENDING/APPROVED, not deleted) document per type: partial unique
/// index in the migration.
model UserDocument {
  id              String         @id @default(uuid(7)) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  type            DocumentType
  /// Required for OTHER, e.g. "Gym membership card".
  label           String?
  frontKey        String         @map("front_key")
  backKey         String?        @map("back_key")
  status          DocumentStatus @default(PENDING)
  rejectionReason String?        @map("rejection_reason")
  reviewedById    String?        @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?      @map("reviewed_at")
  expiresOn       DateTime?      @map("expires_on") @db.Date
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy AdminUser? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, createdAt])
  @@map("user_documents")
}

// ─── Phase 3: listings & categories ──────────────────────────────────────────

/// Admin-managed item categories (flat for the MVP). Launch set seeded by the migration.
model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  /// Material Symbols icon name shown in the apps, e.g. "hiking".
  icon      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listings Listing[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ListingStatus {
  /// Being written by the lender; never public.
  DRAFT
  /// Waiting for admin review (a lender's first listing).
  PENDING
  LIVE
  /// Hidden by the lender; can be unpaused.
  PAUSED
  /// Admin sent it back with a reason; editing returns it to DRAFT.
  REJECTED
  /// Unpublished by an admin.
  REMOVED
  /// Deleted by the lender (soft delete; photos removed from storage).
  DELETED
}

/// An item a lender offers for rent. Money is in paise. The exact pickup point
/// (lat/lng) and address are private; the public API shows an approximate
/// location and `areaLabel`. `location` (geography) is kept in sync with lat/lng
/// by a trigger (see the migration) and used for radius search in Phase 4.
model Listing {
  id                String                    @id @default(uuid(7)) @db.Uuid
  lenderId          String                    @map("lender_id") @db.Uuid
  categoryId        String                    @map("category_id") @db.Uuid
  title             String
  description       String
  condition         ItemCondition
  brand             String?
  size              String?
  pricePerDayPaise  Int                       @map("price_per_day_paise")
  /// Discount for rentals of 7+ days, 0–50.
  weeklyDiscountPct Int                       @default(0) @map("weekly_discount_pct")
  depositPaise      Int                       @map("deposit_paise")
  minDays           Int                       @default(1) @map("min_days")
  maxDays           Int                       @default(30) @map("max_days")
  advanceNoticeDays Int                       @default(1) @map("advance_notice_days")
  lat               Float?
  lng               Float?
  location          Unsupported("geography")?
  /// Full-text search: title (A), brand and category (B), description (C).
  /// Kept in sync by a trigger (see the migrations).
  searchVector      Unsupported("tsvector")?  @map("search_vector")
  /// Public, e.g. "Kothrud, Pune".
  areaLabel         String?                   @map("area_label")
  /// AES-256-GCM (ADDRESS_ENC_KEY); shared with a borrower only after a confirmed booking.
  exactAddressEnc   String?                   @map("exact_address_enc")
  status            ListingStatus             @default(DRAFT)
  rejectionReason   String?                   @map("rejection_reason")
  reviewedById      String?                   @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?                 @map("reviewed_at")
  /// Set when an admin approves it. A lender with any approved listing publishes straight to LIVE.
  approvedAt        DateTime?                 @map("approved_at")
  publishedAt       DateTime?                 @map("published_at")
  deletedAt         DateTime?                 @map("deleted_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  lender        User                 @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  category      Category             @relation(fields: [categoryId], references: [id])
  reviewedBy    AdminUser?           @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  photos        ListingPhoto[]
  requiredDocs  ListingRequiredDoc[]
  blocks        AvailabilityBlock[]
  favorites     Favorite[]
  views         ListingView[]
  conversations Conversation[]

  @@index([lenderId])
  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([location], map: "listings_location_gist", type: Gist)
  @@index([searchVector], map: "listings_search_vector_gin", type: Gin)
  @@map("listings")
}

/// Processed photo in the public bucket: `key` (≤1600px WebP) and `thumbKey` (≤480px WebP).
model ListingPhoto {
  id        String   @id @default(uuid(7)) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  key       String
  thumbKey  String   @map("thumb_key")
  width     Int
  height    Int
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("listing_photos")
}

/// What a borrower must share before a booking (Phase 6 does the sharing).
enum RequiredDocType {
  /// Any of Aadhaar (masked), PAN, driving licence, passport or voter ID.
  GOVERNMENT_ID
  COLLEGE_OR_EMPLOYEE_ID
  ADDRESS_PROOF
  OTHER
}

model ListingRequiredDoc {
  id        String          @id @default(uuid(7)) @db.Uuid
  listingId String          @map("listing_id") @db.Uuid
  docType   RequiredDocType @map("doc_type")
  /// Required for OTHER (CHECK in the migration), e.g. "Trek permit".
  note      String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, docType])
  @@map("listing_required_docs")
}

enum BlockReason {
  OWNER_BLOCK
}

/// Dates the item can't be rented (inclusive). Bookings add their own blocks in Phase 6.
model AvailabilityBlock {
  id        String      @id @default(uuid(7)) @db.Uuid
  listingId String      @map("listing_id") @db.Uuid
  startsOn  DateTime    @map("starts_on") @db.Date
  endsOn    DateTime    @map("ends_on") @db.Date
  reason    BlockReason @default(OWNER_BLOCK)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, startsOn])
  @@map("availability_blocks")
}

// ─── Phase 4: discovery ──────────────────────────────────────────────────────

/// A listing a user saved to their wishlist.
model Favorite {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId, createdAt])
  @@map("favorites")
}

/// One row per viewer per listing per day ("Popular this week"). `viewerKey`
/// is the user id, or for guests a salted hash of IP + user agent + day, so no
/// raw IP is stored.
model ListingView {
  listingId String   @map("listing_id") @db.Uuid
  viewerKey String   @map("viewer_key")
  day       DateTime @db.Date

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([listingId, viewerKey, day])
  @@index([day, listingId])
  @@map("listing_views")
}

// ─── Phase 5: chat, offers, safety, push ─────────────────────────────────────

/// One thread per borrower and listing. Only the borrower starts it.
model Conversation {
  id                 String   @id @default(uuid(7)) @db.Uuid
  listingId          String   @map("listing_id") @db.Uuid
  borrowerId         String   @map("borrower_id") @db.Uuid
  lenderId           String   @map("lender_id") @db.Uuid
  lastMessageAt      DateTime @default(now()) @map("last_message_at")
  /// Masked, so it's safe to show either participant.
  lastMessagePreview String?  @map("last_message_preview")
  createdAt          DateTime @default(now()) @map("created_at")

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  borrower User      @relation("ConversationBorrower", fields: [borrowerId], references: [id], onDelete: Cascade)
  lender   User      @relation("ConversationLender", fields: [lenderId], references: [id], onDelete: Cascade)
  messages Message[]
  offers   Offer[]

  @@unique([listingId, borrowerId])
  @@index([borrowerId, lastMessageAt])
  @@index([lenderId, lastMessageAt])
  @@map("conversations")
}

enum MessageType {
  TEXT
  IMAGE
  OFFER
  SYSTEM
}

/// `body` is what the sender typed (shown to them and to admins); the other
/// participant only ever gets `maskedBody` (contact details replaced with •••).
model Message {
  id             String      @id @default(uuid(7)) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  type           MessageType
  body           String?
  maskedBody     String?     @map("masked_body")
  masked         Boolean     @default(false)
  /// Private bucket: `imageKey` (≤1600px WebP) and `thumbKey` (≤480px WebP).
  imageKey       String?     @map("image_key")
  thumbKey       String?     @map("thumb_key")
  offerId        String?     @unique @map("offer_id") @db.Uuid
  /// The sender's id for this message, so a retried send isn't stored twice.
  clientId       String?     @map("client_id")
  readAt         DateTime?   @map("read_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  offer        Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@unique([conversationId, senderId, clientId])
  @@index([conversationId, id])
  @@map("messages")
}

enum OfferStatus {
  PENDING
  ACCEPTED
  COUNTERED
  DECLINED
  EXPIRED
  /// An accepted deal replaced by a later one in the same conversation.
  SUPERSEDED
}

/// Dates and a price per day proposed in chat. At most one PENDING and one
/// ACCEPTED offer per conversation (partial unique indexes in the migration).
/// Expiry is applied lazily: a PENDING offer past `expiresAt` counts as EXPIRED.
model Offer {
  id               String      @id @default(uuid(7)) @db.Uuid
  conversationId   String      @map("conversation_id") @db.Uuid
  proposedById     String      @map("proposed_by_id") @db.Uuid
  startsOn         DateTime    @map("starts_on") @db.Date
  endsOn           DateTime    @map("ends_on") @db.Date
  days             Int
  pricePerDayPaise Int         @map("price_per_day_paise")
  rentPaise        Int         @map("rent_paise")
  depositPaise     Int         @map("deposit_paise")
  status           OfferStatus @default(PENDING)
  parentOfferId    String?     @map("parent_offer_id") @db.Uuid
  expiresAt        DateTime    @map("expires_at")
  respondedAt      DateTime?   @map("responded_at")
  createdAt        DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  proposedBy   User         @relation(fields: [proposedById], references: [id], onDelete: Cascade)
  parent       Offer?       @relation("OfferCounter", fields: [parentOfferId], references: [id], onDelete: SetNull)
  counters     Offer[]      @relation("OfferCounter")
  message      Message?

  @@index([conversationId, createdAt])
  @@map("offers")
}

/// Either side of a block stops messages and offers both ways.
model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

enum ReportTarget {
  USER
  LISTING
  MESSAGE
}

enum ReportReason {
  SPAM
  SCAM
  OFF_PLATFORM_PAYMENT
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model Report {
  id             String       @id @default(uuid(7)) @db.Uuid
  reporterId     String       @map("reporter_id") @db.Uuid
  targetType     ReportTarget @map("target_type")
  targetId       String       @map("target_id") @db.Uuid
  /// The chat it came from, for context in the admin panel.
  conversationId String?      @map("conversation_id") @db.Uuid
  reason         ReportReason
  note           String?
  status         ReportStatus @default(OPEN)
  resolvedById   String?      @map("resolved_by_id") @db.Uuid
  resolutionNote String?      @map("resolution_note")
  resolvedAt     DateTime?    @map("resolved_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  reporter   User       @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy AdminUser? @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

/// An FCM registration token for one signed-in device (session).
model DeviceToken {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  token      String   @unique
  platform   String
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("device_tokens")
}
