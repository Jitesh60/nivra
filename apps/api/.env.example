# Copy to .env for local development: cp .env.example .env
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Comma-separated origins allowed to call the API from a browser (admin + web).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Serve Swagger UI at /docs (keep false in production).
SWAGGER_ENABLED=true

# infra/docker-compose.yml
DATABASE_URL=postgresql://sajha:sajha@localhost:5432/sajha?schema=public
REDIS_URL=redis://localhost:6379


# Storage (S3), email (SMTP), SMS and JWT settings are added in the phase that uses them.
