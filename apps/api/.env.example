# Copy to .env for local development: cp .env.example .env
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Comma-separated origins allowed to call the API from a browser (admin + web).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Serve Swagger UI at /docs (keep false in production).
SWAGGER_ENABLED=true

# infra/docker-compose.yml
DATABASE_URL=postgresql://sajha:sajha@localhost:5432/sajha?schema=public
REDIS_URL=redis://localhost:6379


# ── Auth (generate real secrets with: openssl rand -base64 48) ──
JWT_ACCESS_SECRET=dev-only-user-access-secret-change-me-0123456789
JWT_ADMIN_ACCESS_SECRET=dev-only-admin-access-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_ACCESS_TOKEN_TTL_SEC=600
ADMIN_REFRESH_TOKEN_TTL_HOURS=12

# ── OTP ──
OTP_PEPPER=dev-only-otp-pepper-change-me-0123456789abcdef
# Development only: accept this code for any OTP. Leave empty to test real codes.
OTP_DEV_BYPASS_CODE=

# ── Admin 2FA: 32 random bytes, base64 (openssl rand -base64 32) ──
TOTP_ENC_KEY=ZGV2LW9ubHktdG90cC1rZXktMzItYnl0ZXMhISEhISE=
TOTP_ISSUER=Sajha Admin (dev)

# ── SMS: console (prints codes to the API log) | msg91 ──
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ── Email: smtp (Mailpit locally, http://localhost:8025) | resend ──
EMAIL_PROVIDER=smtp
EMAIL_FROM=Sajha <no-reply@sajha.app>
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# ── Object storage: SeaweedFS locally (infra/docker-compose.yml), AWS S3 in staging/prod ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=sajha
S3_SECRET_ACCESS_KEY=sajha-s3-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BUCKET=sajha-public-media
S3_PRIVATE_BUCKET=sajha-private-docs
S3_PUBLIC_BASE_URL=http://localhost:9000/sajha-public-media
# AES256 or aws:kms in staging/production (required there); none locally.
S3_PRIVATE_SSE=none
