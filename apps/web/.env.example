# Copy to .env.local: cp .env.example .env.local
# Public URL of the Nivra API (the waitlist form calls it from the browser).
NEXT_PUBLIC_SAJHA_API_URL=http://localhost:3000
# Canonical URL of this site (sitemap, Open Graph, canonical links).
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Store links. When set (at build time) the waitlist is replaced by download buttons.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
# Crash reporting (optional; off when empty).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
